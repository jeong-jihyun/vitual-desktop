# 서버 포트
PORT=8080

# JWT 서명 키 - 반드시 무작위의 긴 문자열로 교체하세요
# 생성 예: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# 데이터 저장 위치 (JSON 파일 기반, 개인용 소규모 배포 기준)
DATA_DIR=./data

# 회원가입 절차 없이, 이 비밀번호로 웹/모바일 브라우저에서 로그인합니다.
# 서버 최초 실행 시 1회만 등록되며, 이후 값을 바꿔도 자동 반영되지 않습니다.
# 비밀번호를 바꾸려면 DATA_DIR/db.json의 "users" 배열을 비우고 서버를 재시작하세요.
OWNER_PASSWORD=change-me-to-your-own-access-password

# 1회성 접속 코드(PIN) / 기기 페어링 코드 유효시간(초)
PIN_TTL_SECONDS=300
PAIR_TTL_SECONDS=300
